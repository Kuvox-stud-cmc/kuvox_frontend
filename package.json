{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "node ./server/index.mjs ./build/server/index.js",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc",
    "verify:editor-cache": "esbuild scripts/editor-cache.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-editor-cache.assertions.mjs && node /tmp/kuvox-editor-cache.assertions.mjs",
    "verify:editor-load": "esbuild scripts/editor-load.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-editor-load.assertions.mjs && node /tmp/kuvox-editor-load.assertions.mjs",
    "verify:editor-media": "esbuild scripts/editor-media.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-editor-media.assertions.mjs && node /tmp/kuvox-editor-media.assertions.mjs",
    "verify:editor-preview": "esbuild scripts/editor-preview.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-editor-preview.assertions.mjs && node /tmp/kuvox-editor-preview.assertions.mjs",
    "verify:editor-state": "esbuild scripts/editor-state.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-editor-state.assertions.mjs && node /tmp/kuvox-editor-state.assertions.mjs",
    "verify:editor-tools": "esbuild scripts/editor-tools.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-editor-tools.assertions.mjs && node /tmp/kuvox-editor-tools.assertions.mjs",
    "verify:editor-timeline": "esbuild scripts/editor-timeline.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-editor-timeline.assertions.mjs && node /tmp/kuvox-editor-timeline.assertions.mjs",
    "verify:video-performance": "esbuild scripts/video-performance.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-performance.assertions.mjs && node /tmp/kuvox-video-performance.assertions.mjs",
    "verify:video-keyboard-accessibility": "esbuild scripts/video-keyboard-accessibility.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-keyboard-accessibility.assertions.mjs && node /tmp/kuvox-video-keyboard-accessibility.assertions.mjs",
    "verify:video-ui-polish": "esbuild scripts/video-ui-polish.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-ui-polish.assertions.mjs && node /tmp/kuvox-video-ui-polish.assertions.mjs",
    "verify:video-ai-planner": "esbuild scripts/video-ai-command-planner.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-ai-command-planner.assertions.mjs && node /tmp/kuvox-video-ai-command-planner.assertions.mjs",
    "verify:video-export": "esbuild scripts/video-export.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-export.assertions.mjs && node /tmp/kuvox-video-export.assertions.mjs",
    "verify:video-render-schema": "esbuild scripts/video-render-schema.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-render-schema.assertions.mjs && node /tmp/kuvox-video-render-schema.assertions.mjs",
    "verify:video-observability": "esbuild scripts/video-observability.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-observability.assertions.mjs && node /tmp/kuvox-video-observability.assertions.mjs",
    "verify:video-retrieval": "esbuild scripts/video-retrieval.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-retrieval.assertions.mjs && node /tmp/kuvox-video-retrieval.assertions.mjs",
    "verify:video-recovery": "esbuild scripts/video-recovery.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-recovery.assertions.mjs && node /tmp/kuvox-video-recovery.assertions.mjs",
    "verify:video-operations": "esbuild scripts/video-operations.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-operations.assertions.mjs && node /tmp/kuvox-video-operations.assertions.mjs",
    "verify:video-testing-strategy": "esbuild scripts/video-testing-strategy.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-testing-strategy.assertions.mjs && node /tmp/kuvox-video-testing-strategy.assertions.mjs",
    "verify:video-mvp-cutline": "esbuild scripts/video-mvp-cutline.assertions.ts --bundle --platform=node --format=esm --outfile=/tmp/kuvox-video-mvp-cutline.assertions.mjs && node /tmp/kuvox-video-mvp-cutline.assertions.mjs",
    "test:video-components": "vitest run --config vitest.video-components.config.ts app/components/editor/video-components.test.tsx",
    "test:e2e": "playwright test",
    "api:types": "node ./scripts/generate-api-types.mjs"
  },
  "dependencies": {
    "@react-router/express": "7.15.1",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@react-three/fiber": "^9.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "express": "^4.22.2",
    "gsap": "^3.15.0",
    "isbot": "^5.1.36",
    "konva": "^10.3.0",
    "motion": "^12.40.0",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.5",
    "react-redux": "^9.3.0",
    "react-router": "7.15.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
