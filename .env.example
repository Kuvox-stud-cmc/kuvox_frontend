# Base URL of the ASP.NET backend the BFF loaders/actions call (server-side).
VITE_API_URL=http://localhost:5280

# Base URL of the AI service the BFF proxy calls (server-side).
VITE_AI_SERVICE_URL=http://localhost:8000

# Runtime-only media AI flags. Restart the frontend server after changing them;
# no frontend rebuild is required.
KUVOX_MEDIA_INGESTION_ENABLED=false
KUVOX_MEDIA_RETRIEVAL_ENABLED=false

# Secret used to sign the httpOnly session cookie. Use a long random value in production.
SESSION_SECRET=dev-only-session-secret-change-me

# Process-local BFF request coalescing and private metrics (all off by default).
KUVOX_BFF_COALESCING_ENABLED=false
KUVOX_BFF_COALESCING_RESOURCES=auth_me,studio_memberships,retrieval_project_media
KUVOX_BFF_COALESCING_MAX_IN_FLIGHT=256
KUVOX_BFF_COALESCING_DEADLINE_MS=5000
KUVOX_BFF_METRICS_ENABLED=false
# Production Redis cache-only single node. Use long, independent secrets.
REDIS_API_PASSWORD=
REDIS_AI_PASSWORD=

# ASP.NET business-read cache rollout flags (all off by default).
API_CACHING_ENABLED=false
API_HTTP_VALIDATORS_ENABLED=false
API_BUSINESS_READ_CACHING_ENABLED=false
API_USER_SETTINGS_CACHING_ENABLED=false
API_STUDIO_CACHING_ENABLED=false
API_PROJECTS_CACHING_ENABLED=false
API_MEDIA_CACHING_ENABLED=false
API_ALBUMS_CACHING_ENABLED=false
API_STORAGE_USAGE_CACHING_ENABLED=false
API_TASKS_CACHING_ENABLED=false
API_NOTIFICATION_PAGES_CACHING_ENABLED=false
API_NOTIFICATION_COUNT_CACHING_ENABLED=false
API_EDITOR_DOCUMENTS_CACHING_ENABLED=false
API_RENDER_JOBS_CACHING_ENABLED=false
API_STAMPEDE_PROTECTION_ENABLED=false
API_STUDIO_USAGE_SINGLE_FLIGHT_ENABLED=false
API_LOCK_TTL_MILLISECONDS=5000
API_LOCK_WAIT_MILLISECONDS=2000
API_LOCK_POLL_MILLISECONDS=50
API_STUDIO_SETTINGS_PREWARM_ENABLED=false
API_TASK_REFERENCE_PREWARM_ENABLED=false
API_PREWARM_QUEUE_CAPACITY=256
API_PREWARM_STARTUP_DELAY_MILLISECONDS=5000
# Empty by default. Additional indexed .NET entries can be passed directly via env_file.
API_PREWARM_STARTUP_STUDIO_ID_0=

# FastAPI retrieval/query coordination flags (all off by default).
KUVOX_CACHE_ENABLED=false
KUVOX_QUERY_EMBEDDING_CACHE_ENABLED=false
KUVOX_QUERY_EMBEDDING_SINGLE_FLIGHT_ENABLED=false
KUVOX_RETRIEVAL_CACHE_ENABLED=false
KUVOX_RETRIEVAL_SINGLE_FLIGHT_ENABLED=false
KUVOX_RETRIEVAL_CACHE_TTL_SECONDS=60
KUVOX_RETRIEVAL_CACHE_BUDGET_BYTES=67108864
KUVOX_SINGLE_FLIGHT_LOCK_TTL_SECONDS=30
KUVOX_SINGLE_FLIGHT_WAIT_SECONDS=15
KUVOX_SINGLE_FLIGHT_POLL_MILLISECONDS=50

# Runtime widget configuration. Restart the frontend container after changing it;
# the widget no longer requires rebuilding the browser bundle.
# Direct Spring development endpoint. Use the gateway `/widget/v1/cacanode-chat.js`
# path only when the CacaNode gateway is running on the configured public origin.
WIDGET_SCRIPT_SRC=http://localhost:8080/widget/widget.js
WIDGET_TOKEN=

# Customer-facing Contact Support uses CacaNode's Custom API through the Kuvox
# server. CACANODE_API_TOKEN must have api:chat scope and is never browser-visible.
CACANODE_API_URL=http://localhost:8080/api/v1
CACANODE_API_TOKEN=
